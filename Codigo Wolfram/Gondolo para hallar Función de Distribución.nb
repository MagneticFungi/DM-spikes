Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
   "Print", "[", "\"\<6. Forma compacta del potencial relativo\>\"", "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eq", "=", 
   RowBox[{"phi0Expr", "//", "PowerExpand"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"eq", "==", "\[Phi]0"}], ",", 
           RowBox[{"Element", "[", 
            RowBox[{"\[Phi]0", ",", "Reals"}], "]"}], ",", 
           RowBox[{
            RowBox[{"Im", "[", "\[Phi]0", "]"}], "==", "0"}], ",", 
           RowBox[{"\[Phi]0", ">", "0"}]}], "}"}], ",", "G"}], "]"}], ",", 
       RowBox[{
        RowBox[{"Element", "[", 
         RowBox[{"\[Phi]0", ",", "Reals"}], "]"}], "&&", 
        RowBox[{
         RowBox[{"Im", "[", "\[Phi]0", "]"}], "==", "0"}], "&&", 
        RowBox[{"\[Phi]0", ">", "0"}]}]}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"phiRel", "[", "r_", "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"deltaPhi", "[", "r", "]"}], "/.", 
     RowBox[{"{", "sol", "}"}]}], "//", "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"phiRel", "[", "r", "]"}]}], "Input",
 CellChangeTimes->{
  3.992212415791525*^9, {3.9922128119350433`*^9, 3.9922128705779533`*^9}, {
   3.99221310092556*^9, 3.992213102287615*^9}, 3.993819051794092*^9},
 CellLabel->"In[18]:=",ExpressionUUID->"4adfc24b-8908-5747-87c3-186addedc5f4"],

