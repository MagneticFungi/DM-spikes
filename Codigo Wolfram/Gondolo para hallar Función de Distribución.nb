          RowBox[{
           RowBox[{"PowerExpand", "[", 
            RowBox[{
             RowBox[{"phiRel", "[", "r", "]"}], "==", "\[Phi]"}], "]"}], ",", 
           "r", ",", 
           RowBox[{"InverseFunctions", "->", "True"}]}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Solve", "::", "nongen"}], ",", 
        RowBox[{"Solve", "::", "ifun"}]}], "}"}]}], "]"}], "//", 
    "PowerExpand"}], "]"}]}]}], "Input",
