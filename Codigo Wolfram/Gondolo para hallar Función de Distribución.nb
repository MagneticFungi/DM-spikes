Cell[BoxData[
 FormBox[
  FractionBox[
   RowBox[{"rho0", " ", 
    SuperscriptBox["\[Phi]0", 
     FractionBox["\[Gamma]", 
      RowBox[{"2", "-", "\[Gamma]"}]]], " ", 
    TemplateBox[{
      RowBox[{
        FractionBox["1", "2"], "-", 
        FractionBox["2", 
         RowBox[{"\[Gamma]", "-", "2"}]]}]},
     "Gamma"], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["2", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{"5", " ", 
           RowBox[{"(", 
            RowBox[{"\[Gamma]", "-", "2"}], ")"}]}], 
          RowBox[{"\[Gamma]", "-", "4"}]]}]], " ", "\[Phi]0", " ", 
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox[
          RowBox[{
           FractionBox[
            RowBox[{"2", " ", "\[Pi]", " ", 
             RowBox[{"(", 
              RowBox[{"\[Gamma]", "-", "2"}], ")"}], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                SqrtBox["2"], " ", 
                SqrtBox[
                 RowBox[{"-", "Ep"}]], " ", "G", " ", "M"}], "+", 
               RowBox[{"2", " ", "Ep", " ", "Lp"}]}], ")"}]}], 
            RowBox[{"Ep", " ", 
             TemplateBox[{
               FractionBox["1", 
                RowBox[{"2", "-", "\[Gamma]"}]], 
               FractionBox["3", "2"]},
              "Beta"]}]], "+", 
           RowBox[{
            SuperscriptBox["2", 
             RowBox[{
              FractionBox["1", 
               RowBox[{"\[Gamma]", "-", "2"}]], "+", "2"}]], " ", 
            SqrtBox[
             FractionBox[
              RowBox[{"\[Gamma]", "-", "4"}], 
              RowBox[{"\[Gamma]", "-", "2"}]]], " ", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"4", "-", "\[Gamma]"}], ")"}], 
             FractionBox["1", 
              RowBox[{"2", "-", "\[Gamma]"}]]], " ", "Lp"}]}], 
          RowBox[{"r0", " ", 
           SqrtBox["\[Phi]0"]}]], ")"}], 
        FractionBox[
         RowBox[{"2", " ", 
          RowBox[{"(", 
           RowBox[{"\[Gamma]", "-", "2"}], ")"}]}], 
         RowBox[{"\[Gamma]", "-", "4"}]]]}], ")"}], 
     RowBox[{
      FractionBox["2", 
       RowBox[{"\[Gamma]", "-", "2"}]], "-", 
      FractionBox["1", "2"]}]]}], 
   RowBox[{"2", " ", 
    SqrtBox["2"], " ", 
    SuperscriptBox["\[Pi]", 
     RowBox[{"3", "/", "2"}]], " ", 
    TemplateBox[{
      FractionBox["\[Gamma]", 
       RowBox[{"2", "-", "\[Gamma]"}]]},
     "Gamma"]}]], TraditionalForm]], "Output",
