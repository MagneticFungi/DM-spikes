Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
   "Print", "[", "\"\<11. Integral de Eddington con el ansatz\>\"", "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rhoFromAnsatzRaw", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"4", " ", "Pi", " ", 
       RowBox[{"Sqrt", "[", "2", "]"}], "*", " ", 
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"fAnsatz", "[", "Egy", "]"}], " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"Egy", "-", "\[Phi]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"Egy", ",", "\[Phi]", ",", "Infinity"}], "}"}], ",", 
         RowBox[{"Assumptions", "->", 
          RowBox[{
           RowBox[{"\[Phi]", ">", "0"}], "&&", 
           RowBox[{"\[Beta]", ">", 
            RowBox[{"3", "/", "2"}]}], "&&", 
           RowBox[{"Cc", ">", "0"}]}]}]}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"\[Phi]", ">", "0"}], "&&", 
       RowBox[{"\[Beta]", ">", 
        RowBox[{"3", "/", "2"}]}], "&&", 
       RowBox[{"Cc", ">", "0"}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"rhoFromAnsatzRaw", "//", "TraditionalForm"}]}], "Input",
 CellChangeTimes->{{3.99220846784367*^9, 3.9922084714399624`*^9}, 
   3.992213689850874*^9, {3.992213871181793*^9, 3.992213876979328*^9}},
 CellLabel->"In[45]:=",ExpressionUUID->"a21882c0-90a9-964e-a62a-4c76ec116f8e"],

