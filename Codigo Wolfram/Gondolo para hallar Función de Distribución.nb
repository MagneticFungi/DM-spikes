Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"x", ",", "z", ",", "y", ",", "p", ",", " ", "rules"}], "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"p", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"4", "-", "\[Gamma]"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{"2", "-", "\[Gamma]"}], ")"}]}], ")"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rules", "=", 
    RowBox[{
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "x", ",", "z", ",", "y", ",", "L", ",", "Lp", ",", "G", ",", "M", ",",
          "r0", ",", "\[Phi]0", ",", "\[Gamma]"}], "}"}], ",", "Reals"}], 
      "]"}], "&&", 
     RowBox[{"x", ">", "0"}], "&&", 
     RowBox[{"z", ">", "0"}], "&&", 
     RowBox[{"y", ">", "0"}], "&&", 
     RowBox[{"L", ">=", "0"}], "&&", 
     RowBox[{"Lp", ">=", "0"}], "&&", 
     RowBox[{"G", ">", "0"}], "&&", 
     RowBox[{"M", ">", "0"}], "&&", 
     RowBox[{"r0", ">", "0"}], "&&", 
     RowBox[{"\[Phi]0", ">", "0"}], "&&", 
     RowBox[{"0", "<", "\[Gamma]", "<", "2"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Diference", "=", 
    RowBox[{"Refine", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Iini", "[", 
        RowBox[{
         RowBox[{"\[Phi]0", " ", "z"}], ",", "L"}], "]"}], "-", 
       RowBox[{"Ifin", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"y", "^", "2"}]}], ",", "Lp"}], "]"}]}], ",", "rules"}], 
     "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eqX", "=", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"Together", "[", 
       RowBox[{"Diference", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"z", "^", "p"}], "->", "x"}], "}"}]}], "]"}], ",", 
      "rules"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"numX", "=", 
    RowBox[{"Collect", "[", 
     RowBox[{
      RowBox[{"Numerator", "[", "eqX", "]"}], ",", "x", ",", "Simplify"}], 
     "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"xSol", "=", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Coefficient", "[", 
         RowBox[{"numX", ",", "x", ",", "0"}], "]"}]}], "/", 
       RowBox[{"Coefficient", "[", 
        RowBox[{"numX", ",", "x", ",", "1"}], "]"}]}], ",", "rules"}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"check", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"eqX", "/.", " ", 
      RowBox[{"x", "->", "xSol"}]}], ",", "rules"}], "]"}]}], ";"}]}], "Input",
