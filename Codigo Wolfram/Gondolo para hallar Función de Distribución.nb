Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Print", "[", "\"\<17. Acciones radiales\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Term1", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"4", "-", "\[Gamma]"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{"2", "-", "\[Gamma]"}], ")"}]}], ")"}]}]}], ";"}], " ", 
  RowBox[{"(*", " ", "\[Nu]", " ", "*)"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Term2", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", "/", 
        RowBox[{"(", 
         RowBox[{"4", "-", "\[Gamma]"}], ")"}]}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"2", "-", "\[Gamma]"}], ")"}]}], ")"}]}], "*", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "-", "\[Gamma]"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"4", "-", "\[Gamma]"}], ")"}]}], "]"}]}]}], ";"}], " ", 
  RowBox[{"(*", " ", "\[Lambda]", " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Term3", "=", 
    RowBox[{"Pi", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", "-", "\[Gamma]"}], ")"}], "/", 
      RowBox[{"Beta", "[", 
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{"2", "-", "\[Gamma]"}], ")"}]}], ",", 
        RowBox[{"3", "/", "2"}]}], "]"}]}]}]}], ";"}], " ", 
  RowBox[{"(*", " ", "b", " ", "*)"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Iini", "[", 
     RowBox[{"Eini_", ",", "Lp_"}], "]"}], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", " ", 
       RowBox[{"Pi", "/", "Term3"}]}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "Lp"}], "/", "Term2"}], "+", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"2", " ", 
          RowBox[{"r0", "^", "2"}], " ", "\[Phi]0"}], "]"}], "*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Eini", "/", "\[Phi]0"}], ")"}], "^", "Term1"}]}]}], 
      ")"}]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "Esta", " ", "es", " ", "bajo", " ", "la", " ", "aproximaci\[OAcute]n", " ", 
    RowBox[{"(", "DETERMINAR", ")"}]}], "*)"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Ifin", "[", 
     RowBox[{"Ep_", ",", "Lp_"}], "]"}], "=", 
    RowBox[{"2", " ", "Pi", "*", 
     RowBox[{"(", 
