   "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"expEsperado", "=", 
    RowBox[{
     RowBox[{"-", "\[Gamma]"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", "-", "\[Gamma]"}], ")"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"expAnsatz", "=", 
    RowBox[{
     RowBox[{"3", "/", "2"}], "-", "\[Beta]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
