(Ser\[IAcute]a bueno generalizar esto): \>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rhoPhi", ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Cambio", " ", "de", " ", "variable", " ", "sin", " ", 
     "sub\[IAcute]ndice"}], ",", " ", 
    RowBox[{
    "pues", " ", "Mathematica", " ", "no", " ", "puede", " ", "derivar", " ", 
     "con", " ", "un", " ", "Subscript"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rhoPhiTemp", "=", 
   RowBox[{"rhoPhi", "/.", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Subscript", "[", 
        RowBox[{"\[Phi]", ",", "0"}], "]"}], "->", "\[Phi]0"}], ",", 
      RowBox[{
       RowBox[{"Subscript", "[", 
        RowBox[{"\[Rho]", ",", "0"}], "]"}], "->", "\[Rho]0"}]}], "}"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"alphaExp", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "\[Phi]"}], " ", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"rhoPhiTemp", "/", "\[Rho]0"}], "]"}], ",", "\[Phi]"}], 
       "]"}]}], ",", 
     RowBox[{
      RowBox[{"\[Phi]", ">", "0"}], "&&", 
      RowBox[{"\[Phi]0", ">", "0"}], "&&", 
      RowBox[{"\[Rho]0", ">", "0"}], "&&", 
      RowBox[{"0", "<", "\[Gamma]", "<", "2"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"alphaExp", "//", "TraditionalForm", " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Solo", " ", "para", " ", "imprimir"}], ",", " ", 
    RowBox[{
    "no", " ", "funciona", " ", "en", " ", "el", " ", "c\[AAcute]lculo"}]}], 
   " ", "*)"}]}]}], "Input",
