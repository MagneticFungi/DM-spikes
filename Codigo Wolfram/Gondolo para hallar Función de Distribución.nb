 RowBox[{
  RowBox[{"expEsperado", "//", "TraditionalForm"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Exponente producido por el ansatz:\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"expAnsatz", "//", "TraditionalForm"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"betaSol", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"\[Beta]", "/.", " ", 
       RowBox[{"First", "[", 
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{"expAnsatz", "==", "expEsperado"}], ",", "\[Beta]"}], "]"}],
         "]"}]}], ",", 
      RowBox[{"0", "<", "\[Gamma]", "<", "2"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<beta obtenido:\>\"", "]"}], ";"}], "\n", 
 RowBox[{"betaSol", "//", "TraditionalForm"}]}], "Input",
